{
  "hosts": {
    "linux-amd64": {
      "ssh": "build-linux-amd64",
      "repository": "/srv/source/orbit-java",
      "target": "linux-x64-gnu",
      "jobs": 4
    },
    "linux-arm64": {
      "ssh": "build-linux-arm64",
      "repository": "/srv/source/orbit-java",
      "target": "linux-arm64-gnu",
      "jobs": 4
    },
    "freebsd-amd64": {
      "ssh": "build-freebsd-amd64",
      "repository": "/srv/source/orbit-java",
      "target": "freebsd-x64",
      "jobs": 4
    },
    "freebsd-arm64": {
      "ssh": "build-freebsd-arm64",
      "repository": "/srv/source/orbit-java",
      "target": "freebsd-arm64",
      "jobs": 4
    }
  }
}
